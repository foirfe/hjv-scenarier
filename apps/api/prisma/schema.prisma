generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum AnswerType {
  MULTIPLE_CHOICE
  FREE_TEXT
  YES_NO
}

enum ScenarioStatus {
  DRAFT
  READY
  ARCHIVED
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ScenarioRole {
  PARTICIPANT
  TEAM_LEADER
  INSTRUCTOR
}

enum ScenarioRunStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum ActivationMode {
  GEO
  AUTOMATIC
  MANUAL
}

enum TaskProgressStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  COMPLETED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  scenarioRunUsers ScenarioRunUser[]
  taskProgress     ScenarioRunTaskProgress[]

  @@map("users")
}

model Task {
  id                     String      @id @default(uuid()) @db.Uuid
  name                   String
  description            String?
  instructions           String
  instructorInstructions String?     @map("instructor_instructions")
  status                 TaskStatus
  answerType             AnswerType? @map("answer_type")

  environmentId Int @map("environment_id")
  taskTypeId    Int @map("task_type_id")

  environment Environment @relation(fields: [environmentId], references: [id])
  taskType    TaskType    @relation(fields: [taskTypeId], references: [id])

  options        TaskOption[]
  checklistItems TaskChecklistItem[]
  scenarioTasks  ScenarioTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model TaskOption {
  id         String  @id @default(uuid()) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  optionText String  @map("option_text")
  isCorrect  Boolean @map("is_correct")
  sortOrder  Int     @map("sort_order")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_options")
}

model TaskType {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  tasks Task[]

  @@map("task_types")
}

model TaskChecklistItem {
  id        String @id @default(uuid()) @db.Uuid
  taskId    String @map("task_id") @db.Uuid
  itemText  String @map("item_text")
  sortOrder Int    @map("sort_order")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklist_items")
}

model Environment {
  id   Int    @id @default(autoincrement())
  name String @unique

  tasks Task[]

  @@map("environments")
}

model Scenario {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ScenarioStatus @default(DRAFT)

  scenarioTasks ScenarioTask[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  scenarioRuns ScenarioRun[]

  @@map("scenarios")
}

model ScenarioTask {
  id             String         @id @default(uuid()) @db.Uuid
  scenarioId     String         @map("scenario_id") @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  activationMode ActivationMode @default(GEO) @map("activation_mode")

  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  radiusMeters Int?     @map("radius_meters")

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id])

  dependencies ScenarioTaskDependency[] @relation("TaskDependencies")
  requiredBy   ScenarioTaskDependency[] @relation("TaskPrerequisites")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scenario_tasks")
}

model ScenarioTaskDependency {
  scenarioTaskId     String @map("scenario_task_id") @db.Uuid
  prerequisiteTaskId String @map("prerequisite_task_id") @db.Uuid

  scenarioTask     ScenarioTask @relation("TaskDependencies", fields: [scenarioTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask ScenarioTask @relation("TaskPrerequisites", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([scenarioTaskId, prerequisiteTaskId])
  @@map("scenario_task_dependencies")
}

model ScenarioRun {
  id         String            @id @default(uuid()) @db.Uuid
  name       String?
  scenarioId String            @map("scenario_id") @db.Uuid
  status     ScenarioRunStatus @default(NOT_STARTED)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  scenario Scenario          @relation(fields: [scenarioId], references: [id])
  users    ScenarioRunUser[]
  tasks    ScenarioRunTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scenario_runs")
}

model ScenarioRunUser {
  scenarioRunId String       @map("scenario_run_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  role          ScenarioRole

  scenarioRun ScenarioRun @relation(fields: [scenarioRunId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@id([scenarioRunId, userId])
  @@map("scenario_run_users")
}

model ScenarioRunTask {
  id            String @id @default(uuid()) @db.Uuid
  scenarioRunId String @map("scenario_run_id") @db.Uuid

  sourceScenarioTaskId String @map("source_scenario_task_id") @db.Uuid
  sourceTaskId         String @map("source_task_id") @db.Uuid

  name                   String
  description            String?
  instructions           String
  instructorInstructions String?     @map("instructor_instructions")
  answerType             AnswerType? @map("answer_type")
  taskTypeCode           String      @map("task_type_code")

  activationMode ActivationMode @default(GEO) @map("activation_mode")

  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  radiusMeters Int?     @map("radius_meters")

  scenarioRun ScenarioRun @relation(fields: [scenarioRunId], references: [id], onDelete: Cascade)

  options        ScenarioRunTaskOption[]
  checklistItems ScenarioRunTaskChecklistItem[]
  progress       ScenarioRunTaskProgress[]

  dependencies ScenarioRunTaskDependency[] @relation("RunTaskDependencies")
  requiredBy   ScenarioRunTaskDependency[] @relation("RunTaskPrerequisites")

  createdAt         DateTime  @default(now()) @map("created_at")
  manualActivatedAt DateTime? @map("manual_activated_at")

  @@unique([scenarioRunId, sourceScenarioTaskId])
  @@map("scenario_run_tasks")
}

model ScenarioRunTaskOption {
  id                String @id @default(uuid()) @db.Uuid
  scenarioRunTaskId String @map("scenario_run_task_id") @db.Uuid

  optionText String  @map("option_text")
  isCorrect  Boolean @map("is_correct")
  sortOrder  Int     @map("sort_order")

  scenarioRunTask ScenarioRunTask @relation(fields: [scenarioRunTaskId], references: [id], onDelete: Cascade)

  @@map("scenario_run_task_options")
}

model ScenarioRunTaskDependency {
  scenarioRunTaskId     String @map("scenario_run_task_id") @db.Uuid
  prerequisiteRunTaskId String @map("prerequisite_run_task_id") @db.Uuid

  scenarioRunTask ScenarioRunTask @relation("RunTaskDependencies", fields: [scenarioRunTaskId], references: [id], onDelete: Cascade)

  prerequisiteRunTask ScenarioRunTask @relation("RunTaskPrerequisites", fields: [prerequisiteRunTaskId], references: [id], onDelete: Cascade)

  @@id([scenarioRunTaskId, prerequisiteRunTaskId])
  @@map("scenario_run_task_dependencies")
}

model ScenarioRunTaskProgress {
  scenarioRunTaskId String @map("scenario_run_task_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid

  status TaskProgressStatus @default(LOCKED)

  availableAt DateTime? @map("available_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  answerText              String?   @map("answer_text")
  selectedOptionIds       Json?     @map("selected_option_ids")
  answerCorrect           Boolean?  @map("answer_correct")
  answeredAt              DateTime? @map("answered_at")
  checkedChecklistItemIds Json?     @map("checked_checklist_item_ids")

  scenarioRunTask ScenarioRunTask @relation(fields: [scenarioRunTaskId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([scenarioRunTaskId, userId])
  @@map("scenario_run_task_progress")
}

model ScenarioRunTaskChecklistItem {
  id                String @id @default(uuid()) @db.Uuid
  scenarioRunTaskId String @map("scenario_run_task_id") @db.Uuid

  sourceChecklistItemId String @map("source_checklist_item_id") @db.Uuid

  itemText  String @map("item_text")
  sortOrder Int    @map("sort_order")

  scenarioRunTask ScenarioRunTask @relation(fields: [scenarioRunTaskId], references: [id], onDelete: Cascade)

  @@map("scenario_run_task_checklist_items")
}
