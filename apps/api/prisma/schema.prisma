generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum AnswerType {
  MULTIPLE_CHOICE
  FREE_TEXT
  YES_NO
}

enum ScenarioStatus {
  DRAFT
  READY
  ARCHIVED
}

model Task {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  instructions String
  status       TaskStatus
  answerType   AnswerType? @map("answer_type")

  environmentId Int @map("environment_id")
  taskTypeId    Int @map("task_type_id")

  environment Environment @relation(fields: [environmentId], references: [id])
  taskType    TaskType    @relation(fields: [taskTypeId], references: [id])

  options       TaskOption[]
  scenarioTasks ScenarioTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model TaskOption {
  id         String  @id @default(uuid()) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  optionText String  @map("option_text")
  isCorrect  Boolean @map("is_correct")
  sortOrder  Int     @map("sort_order")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_options")
}

model TaskType {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  tasks Task[]

  @@map("task_types")
}

model Environment {
  id   Int    @id @default(autoincrement())
  name String @unique

  tasks Task[]

  @@map("environments")
}

model Scenario {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ScenarioStatus @default(DRAFT)

  scenarioTasks ScenarioTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scenarios")
}

model ScenarioTask {
  id         String @id @default(uuid()) @db.Uuid
  scenarioId String @map("scenario_id") @db.Uuid
  taskId     String @map("task_id") @db.Uuid

  latitude     Decimal @db.Decimal(9, 6)
  longitude    Decimal @db.Decimal(9, 6)
  radiusMeters Int     @map("radius_meters")

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id])

  dependencies ScenarioTaskDependency[] @relation("TaskDependencies")
  requiredBy   ScenarioTaskDependency[] @relation("TaskPrerequisites")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scenario_tasks")
}

model ScenarioTaskDependency {
  scenarioTaskId     String @map("scenario_task_id") @db.Uuid
  prerequisiteTaskId String @map("prerequisite_task_id") @db.Uuid

  scenarioTask     ScenarioTask @relation("TaskDependencies", fields: [scenarioTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask ScenarioTask @relation("TaskPrerequisites", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([scenarioTaskId, prerequisiteTaskId])
  @@map("scenario_task_dependencies")
}
